# Fallback protection if this data/ folder ends up inside the public web root
# (the preferred setup is placing it one level above the web root instead,
# per the deployment notes). Blocks direct URL access to documents.json,
# uploaded files, and the keyword CSV — the app only ever serves files
# through the /download route.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
